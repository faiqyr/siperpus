# =============================================================
#  .gitignore — SIPERpus
# =============================================================

# ------------------------------------------------------------------
# [1] KREDENSIAL — JANGAN PERNAH push file ini ke GitHub!
# ------------------------------------------------------------------
# config/koneksi.php TIDAK di-ignore lagi karena versi yang ada di repo
# hanya membaca environment variables (tidak ada password hardcode).
# Password asli HANYA ada di Railway Environment Variables.
config/koneksi_local.php
.env
.env.*

# ------------------------------------------------------------------
# [2] RAILWAY — file konfigurasi ini HARUS masuk git (jangan ignore)
# Nixpacks.toml, Procfile, router.php, dan koneksi.php.example
# adalah bagian dari deployment dan aman untuk dipublikasikan.
# ------------------------------------------------------------------
# (tidak ada yang perlu diabaikan di sini, Railway files sudah aman)

# ------------------------------------------------------------------
# [3] DEPENDENCIES
# ------------------------------------------------------------------
vendor/
node_modules/

# ------------------------------------------------------------------
# [4] LOGS & TEMPORARY FILES
# ------------------------------------------------------------------
logs/*.log
*.log
*.tmp
*.bak
scratch/

# Biarkan folder logs/ tetap ada di repo (tapi kosong)
!logs/.gitkeep

# ------------------------------------------------------------------
# [5] OS & IDE FILES
# ------------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
desktop.ini
